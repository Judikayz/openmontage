# Frontend build-time URL only; do not put credentials in VITE_* variables.
VITE_API_BASE_URL=https://YOUR-WORKER.workers.dev

# Worker secrets (set with `wrangler secret put`, not in this file):
# ENCRYPTION_KEY              base64-encoded 32-byte AES-256 key
# MODEL_IMPORT_WORKER_TOKEN   random high-entropy token shared with GitHub Actions secret
# GITHUB_TOKEN                token allowed to dispatch repository workflows
# GITHUB_OWNER                GitHub owner/org
# GITHUB_REPO                 this independent control-platform repository
# WORKER_CALLBACK_TOKEN       random token for job callbacks
# KAGGLE credentials          encrypted through Settings when configured
# R2 credentials              encrypted through Settings; bucket must be omcs-models

# ADMIN_EMAIL                owner email allowed to administer user roles
# KAGGLE_DISPATCHER_TOKEN    shared secret for your trusted Kaggle dispatcher

# Worker vars in apps/api/wrangler.toml:
# ALLOWED_ORIGIN=https://YOUR-SITE.netlify.app
# CF_ACCESS_TEAM_DOMAIN=YOUR-TEAM.cloudflareaccess.com
# CF_ACCESS_AUD=YOUR-CLOUDFLARE-ACCESS-APPLICATION-AUD
# MODEL_BUCKET_NAME=omcs-models
